# Однослойный вариант — только для сравнения размера образа.
# Не является частью задания и не используется в CI.
FROM python:3.12

WORKDIR /app

COPY . .

RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 5000

CMD ["python", "-m", "flask", "--app", "run", "run", "--host=0.0.0.0", "--port=5000"]
